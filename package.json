  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@sanity/vision": "^5.21.0",
    "next-themes": "^0.4.6",
    "react": "^19.1",
    "react-dom": "^19.1",
    "resend": "^6.8.0",
    "sanity": "^5.21.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/react": "^19.1",
    "eslint": "^9.28",
    "prettier": "^3.5",
    "typescript": "^5.8"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  }
