{
  "name": "frisia-immobilien",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "npm --prefix web install --include=dev",
    "dev": "npm --prefix web run dev",
    "dev:inside": "cd inside && ../node_modules/.bin/next dev --webpack",
    "start": "npm --prefix web run start",
    "build": "npm --prefix web run build",
    "build:inside": "cd inside && ../node_modules/.bin/next build",
    "build:studio": "sanity build",
    "package:inside": "node scripts/package-frisia-inside.mjs",
    "sync:website-snapshot": "node scripts/sync-website-snapshot.mjs",
    "deploy:inside": "PYTHONPYCACHEPREFIX=/tmp python3 scripts/deploy-frisia-inside-ftps.py",
    "upload-config:inside": "PYTHONPYCACHEPREFIX=/tmp python3 scripts/upload-frisia-inside-config.py",
    "bootstrap:inside": "PYTHONPYCACHEPREFIX=/tmp python3 scripts/bootstrap-frisia-inside.py",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@sanity/vision": "^5.21.0",
    "next": "16.1.4",
    "next-themes": "^0.4.6",
    "react": "^19.1",
    "react-dom": "^19.1",
    "sanity": "^5.21.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/react": "^19.1",
    "eslint": "^9.28",
    "prettier": "^3.5",
    "typescript": "^5.8"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  }
}
